{
  "name": "@codebolt/agent-message",
  "version": "0.1.2",
  "description": "Central communication CLI and provider runtime for agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-message": "dist/cli.cjs"
  },
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.cjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "postbuild": "node scripts/write-public-types.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
